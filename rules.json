      "id": "e171",
      "group": "eu-food",
      "name": "Titanium dioxide (E171)",
      "applies": ["food"],
      "level": "high",
      "reason": "Banned as a food additive in the EU since 2022. EFSA no longer considers it safe in food. Can still appear in imported food.",
      "terms": ["e171", "titanium dioxide", "titandioxid", "dioxyde de titane", "biossido di titanio", "dioxido de titanio"],
      "tags": ["en:e171"],
      "source": { "label": "Regulation (EU) 2022/63", "url": "https://eur-lex.europa.eu/eli/reg/2022/63/oj" }
    },
    {
      "id": "trans-fat",
      "group": "eu-food",
      "name": "Partially hydrogenated fat",
      "applies": ["food"],
      "level": "medium",
      "reason": "Main source of industrial trans fat. The EU limits industrial trans fat to 2 g per 100 g of fat.",
      "terms": ["partially hydrogenated", "teilweise gehartet*", "teilweise hydriert*", "partiellement hydrogen*", "parzialmente idrogenat*", "parcialmente hidrogenad*"],
      "tags": [],
