    {
      "id": "nitrite",
      "group": "health",
      "name": "Nitrite and nitrate (E249 to E252)",
      "applies": ["food"],
      "level": "medium",
      "reason": "IARC: probably causes cancer in humans (Group 2A) when it forms nitroso compounds in the body. Common in cured meat as curing salt.",
      "terms": [
        "e249", "e250", "e251", "e252",
        "sodium nitrite", "natriumnitrit", "potassium nitrite", "kaliumnitrit",
        "sodium nitrate", "natriumnitrat", "potassium nitrate", "kaliumnitrat",
        "nitritpokelsalz", "nitrit pokelsalz", "nitrite curing salt", "nitrited curing salt", "sel nitrite", "nitrite de sodium", "nitrate de potassium"
      ],
      "tags": ["en:e249", "en:e250", "en:e251", "en:e252"],
      "source": { "label": "IARC Monograph 94 (2010), summary by UK FSA", "url": "https://science.food.gov.uk/article/144676-safety-of-nitrates-and-nitrites-as-food-additives" }
    },
