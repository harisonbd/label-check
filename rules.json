        "e122", "azorubine", "azorubin", "carmoisine",
        "e124", "ponceau 4r", "cochenillerot a",
        "e129", "allura red", "allura red ac", "allurarot ac", "rouge allura ac"
      ],
      "tags": ["en:e102", "en:e104", "en:e110", "en:e122", "en:e124", "en:e129"],
